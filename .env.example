# Application settings
APP_NAME="Database Metadata Catalog"
APP_VERSION="0.1.0"
DEBUG=False
LOG_LEVEL=INFO

# Catalog Database (PostgreSQL)
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=metadata_catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://catalog_user:your_secure_password@localhost:5432/metadata_catalog

# Teradata Connection Configuration
TERADATA_HOST=your-teradata-hostname
TERADATA_PORT=1025
TERADATA_USER=your-username
TERADATA_PASSWORD=your-password
TERADATA_DATABASE=default_database

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Scheduler Settings
SCHEDULER_ENABLED=True
SCHEDULER_TIMEZONE=UTC
METADATA_SYNC_INTERVAL=3600  # seconds (1 hour)
USAGE_STATS_INTERVAL=1800    # seconds (30 minutes)

# Search (optional - for Elasticsearch)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_ENABLED=False

# Logging
LOG_FILE=logs/app.log
LOG_FORMAT=json
