# Teradata Connection Configuration
TERADATA_HOST=your-teradata-hostname
TERADATA_PORT=1025
TERADATA_USER=your-username
TERADATA_PASSWORD=your-password
TERADATA_DATABASE=default_database

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default  # or your specific AWS profile
AWS_GLUE_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/GlueJobRole

# S3 Bucket Configuration
S3_BUCKET_RAW=teradata-migration-raw
S3_BUCKET_PROCESSED=teradata-migration-processed
S3_BUCKET_METADATA=teradata-migration-metadata

# Migration Settings
MIGRATION_BATCH_SIZE=10000
MIGRATION_FORMAT=parquet
MIGRATION_COMPRESSION=snappy

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/migration.log
